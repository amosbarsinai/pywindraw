from typing import overload, ClassVar

class Color:
    """RGBA color class."""

    red: int
    green: int
    blue: int
    alpha: int
    RED: ClassVar[Color] = ...
    GREEN: ClassVar[Color] = ...
    BLUE: ClassVar[Color] = ...
    YELLOW: ClassVar[Color] = ...
    CYAN: ClassVar[Color] = ...
    MAGENTA: ClassVar[Color] = ...
    ORANGE: ClassVar[Color] = ...
    BROWN: ClassVar[Color] = ...
    BLACK: ClassVar[Color] = ...
    GREY: ClassVar[Color] = ...
    WHITE: ClassVar[Color] = ...

    @overload
    def __init__(self):
        """Create a new white color."""
        ...
    @overload
    def __init__(self, r: float, g: float, b: float, a: float = 255):
        """Create a new color with RGBA values."""
        ...
